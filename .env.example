YANDEX_MUSIC_TOKEN=

# Качество аудио: lq (компактное) / nq / hq (стандартное) / lossless (без потерь)
YM_QUALITY=lq
# Разрешение загружаемых обложек в пикселях
YM_COVER_SIZE=200
# Число параллельных потоков загрузки треков
YM_MAX_WORKERS=4
# Размер пакета при запросе метаданных треков у API
YM_TRACK_FETCH_BATCH=20
# Число треков, возвращаемых API за один запрос
YM_UI_PAGE_SIZE=50
# Порог размера файла в байтах, выше которого аудио считается избыточно тяжёлым
YM_LOSSLESS_MIN_BYTES=6291456
# 1 - включать время обработки сервера (server_ms) в ответы API; 0 - отключить
YM_DEV_PERF=1

# Сетевой интерфейс для прослушивания
FLASK_HOST=0.0.0.0
# Порт веб-сервера
FLASK_PORT=5000
